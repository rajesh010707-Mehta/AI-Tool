# ==========================================
# AI Knowledge Cloud System - Environment Variables
# ==========================================

# 1. Google Gemini API Keys
# GOOGLE_API_KEY for standard text/vision embeddings and RAG
GOOGLE_API_KEY=your_gemini_api_key_here

# GEMINI_LIVE_API_KEY for real-time WebSocket Multimodal Live API
GEMINI_LIVE_API_KEY=your_gemini_live_api_key_here

# 2. Supabase Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key

# 3. PostgreSQL Direct Database Connection (with pgvector enabled)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 4. Optional Server Configurations
PORT=5000
FLASK_ENV=production
CORS_ORIGIN=*

# 5. Verified Administrator & Developer Email (Anti-Spoofing Security)
ADMIN_EMAIL=rajesh010707@gmail.com
